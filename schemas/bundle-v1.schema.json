{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-bulkinstall:bundle:v1",
  "title": "Moodle plugin bundle manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatversion", "id", "name", "version", "plugins"],
  "properties": {
    "format": {
      "const": "moodle-plugin-bundle"
    },
    "formatversion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "component", "sha256"],
        "properties": {
          "file": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^/\\\\\\u0000-\\u001F]+\\.[Zz][Ii][Pp]$"
          },
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*_[a-z][a-z0-9_]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    }
  }
}
