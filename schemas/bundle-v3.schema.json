{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-bulkinstall:bundle:v3",
  "title": "Signed Moodle plugin bundle manifest version 3",
  "$comment": "Activation metadata coordinates the post-install wizard; it is not proof of ownership or a licence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatversion", "id", "name", "version", "description", "publisher", "keyid", "plugins", "activation", "signature"],
  "properties": {
    "format": {"const": "moodle-plugin-bundle"},
    "formatversion": {"const": 3},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,99}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "maxLength": 2000},
    "publisher": {"const": "108design"},
    "keyid": {"const": "bundle-2026-01"},
    "plugins": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "component", "sha256"],
        "properties": {
          "file": {"type": "string", "maxLength": 255, "pattern": "^[^/\\\\\\u0000-\\u001F]+\\.[Zz][Ii][Pp]$"},
          "component": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_[a-z][a-z0-9_]*$"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["storeproduct", "licencemanager", "entitlements"],
      "properties": {
        "storeproduct": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,99}$"},
        "licencemanager": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "minimumversion"],
          "properties": {
            "required": {"type": "boolean"},
            "minimumversion": {"type": "integer", "minimum": 0}
          }
        },
        "entitlements": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "licencemodel", "components"],
            "properties": {
              "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,190}$"},
              "licencemodel": {"enum": ["commercial", "permanent_free"]},
              "components": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_[a-z][a-z0-9_]*$"}
              }
            }
          }
        }
      }
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
