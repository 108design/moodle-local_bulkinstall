{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-bulkinstall:bundle:v2",
  "title": "Signed Moodle plugin bundle manifest version 2",
  "$comment": "The outer 108design archive filename must match ^bundle_[a-z0-9][a-z0-9._-]*\\.zip$; this is outside the JSON instance and therefore cannot be expressed as a manifest property constraint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatversion", "id", "name", "version", "description", "publisher", "keyid", "plugins", "signature"],
  "properties": {
    "format": {"const": "moodle-plugin-bundle"},
    "formatversion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,99}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "maxLength": 2000},
    "publisher": {"const": "108design"},
    "keyid": {"const": "bundle-2026-01"},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "component", "sha256"],
        "properties": {
          "file": {"type": "string", "maxLength": 255, "pattern": "^[^/\\\\\\u0000-\\u001F]+\\.[Zz][Ii][Pp]$"},
          "component": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_[a-z][a-z0-9_]*$"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
